         <Path.RenderTransform>
          <MatrixTransform Matrix="0.643717398,0,0,0.643717398,-52.429480110,-103.382934858" />
         </Path.RenderTransform>
        </Path>
       </Canvas>
      </Viewbox>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="Codex" FontSize="22" FontWeight="SemiBold" />
       <TextBlock Text="连接助手" FontSize="13" Foreground="{StaticResource IconInk}" Margin="0,3,0,0" />
      </StackPanel>
     </StackPanel>
    </StackPanel>
    <Expander x:Name="profileManager" Grid.Row="1" VerticalAlignment="Top" ExpandDirection="Down" Style="{StaticResource ProfileDisclosure}" IsExpanded="False" Margin="0,0,0,14" AutomationProperties.Name="选择和管理 API 配置" ToolTip="点击切换接口，或管理多个 API 配置">
     <Expander.Header>
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="32" />
        <ColumnDefinition Width="*" />
       </Grid.ColumnDefinitions>
       <Border Width="25" Height="28" Background="{StaticResource AccentSurface}" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Left">
        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource ActionInk}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
       </Border>
       <StackPanel Grid.Column="1">
        <TextBlock Text="API 配置" Foreground="{StaticResource ActionInk}" FontSize="14" FontWeight="SemiBold" />
        <TextBlock x:Name="selectedProfileName" Text="选择接口" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="{StaticResource SecondaryInk}" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
       </StackPanel>
      </Grid>
     </Expander.Header>
     <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Divider}" BorderThickness="{DynamicResource ControlStroke}" CornerRadius="12" Padding="12,12" Margin="0,5,0,0">
      <StackPanel>
       <DockPanel Margin="3,0,0,8">
        <Button x:Name="addButton" DockPanel.Dock="Right" Content="＋ 新增" Style="{StaticResource Quiet}" FontSize="13" MinHeight="30" Padding="8,3" ToolTip="添加 API 配置" />
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
         <TextBlock Text="已保存" FontSize="13" Foreground="{StaticResource IconInk}" />
         <TextBlock x:Name="profileCount" FontSize="13" Foreground="{StaticResource IconInk}" Margin="6,0,0,0" />
        </StackPanel>
       </DockPanel>
       <Grid Margin="0,0,0,7">
        <TextBox x:Name="profileFilter" AutomationProperties.Name="搜索接口" MinHeight="40" Padding="11,8" FontSize="13" />
        <TextBlock Text="搜索名称或域名" Foreground="{StaticResource MutedInk}" FontSize="13" Margin="9,0,25,0" VerticalAlignment="Center" IsHitTestVisible="False">
         <TextBlock.Style>
          <Style TargetType="TextBlock">
           <Setter Property="Visibility" Value="Collapsed" />
           <Style.Triggers>
            <DataTrigger Binding="{Binding Text, ElementName=profileFilter}" Value="">
             <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </TextBlock.Style>
        </TextBlock>
        <Button x:Name="clearFilterButton" Visibility="Collapsed" Content="×" Style="{StaticResource Quiet}" HorizontalAlignment="Right" Padding="5,0" MinHeight="24" FontSize="14" ToolTip="清除搜索" AutomationProperties.Name="清除接口搜索" />
       </Grid>
       <Grid>
        <ListBox Height="200" x:Name="profilesList" Background="Transparent" Foreground="{StaticResource SecondaryInk}" FocusVisualStyle="{x:Null}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
         <ListBox.Template>
          <ControlTemplate TargetType="ListBox">
           <ScrollViewer x:Name="PART_ScrollViewer" Style="{StaticResource CompactScroll}" Focusable="False" CanContentScroll="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsPresenter />
           </ScrollViewer>
          </ControlTemplate>
         </ListBox.Template>
         <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
           <Setter Property="FocusVisualStyle" Value="{x:Null}" />
           <Setter Property="Foreground" Value="#42475F" />
           <Setter Property="HorizontalContentAlignment" Value="Stretch" />
           <Setter Property="Margin" Value="0,0,0,5" />
           <Setter Property="Padding" Value="10,10" />
           <Setter Property="Template">
            <Setter.Value>
             <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderThickness="{DynamicResource ControlStroke}" BorderBrush="Transparent">
               <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
               <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#E6EEF7" />
               </Trigger>
               <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{StaticResource Surface}" />
                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Divider}" />
                <Setter Property="Foreground" Value="{StaticResource SelectedInk}" />
               </Trigger>
               <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Row" Property="BorderBrush" Value="#375EBB" />
               </Trigger>
              </ControlTemplate.Triggers>
             </ControlTemplate>
            </Setter.Value>
           </Setter>
          </Style>
         </ListBox.ItemContainerStyle>
         <ListBox.ItemTemplate>
          <DataTemplate>
           <Grid>
            <Grid.ColumnDefinitions>
             <ColumnDefinition Width="18" />
             <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Ellipse Width="5" Height="5" Fill="#7D9DC6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,7,0,0" />
            <StackPanel Grid.Column="1">
             <TextBlock Text="{Binding name}" ToolTip="{Binding name}" FontSize="14" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
             <TextBlock Text="{Binding display_host}" ToolTip="{Binding display_host}" Foreground="{StaticResource IconInk}" FontSize="13" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>
           </Grid>
          </DataTemplate>
         </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="emptyProfiles" Text="没有匹配的配置" FontSize="13" Foreground="{StaticResource IconInk}" Margin="8,14,8,0" Visibility="Collapsed" IsHitTestVisible="False" />
       </Grid>
       <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
        <Button x:Name="copyButton" Content="复制配置" Style="{StaticResource Quiet}" MinHeight="34" Padding="10,6" FontSize="13" />
        <Button x:Name="deleteButton" Content="移除" Style="{StaticResource Quiet}" MinHeight="34" Padding="10,6" FontSize="13" />
       </StackPanel>
      </StackPanel>
     </Border>
    </Expander>
    <ScrollViewer x:Name="navScroll" Grid.Row="2" Style="{StaticResource CompactScroll}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <RadioButton x:Name="navHome" Style="{StaticResource Tab}" AutomationProperties.Name="切换连接">
       <StackPanel Orientation="Horizontal">
        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="25" VerticalAlignment="Center" />
        <TextBlock Text="切换连接" VerticalAlignment="Center" />
       </StackPanel>
      </RadioButton>
      <TextBlock Text="连接设置" FontSize="13" Foreground="{StaticResource IconInk}" Margin="14,18,0,7" />
      <RadioButton x:Name="navConnection" Style="{StaticResource Tab}" AutomationProperties.Name="连接与模型">
       <StackPanel Orientation="Horizontal">
        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="25" VerticalAlignment="Center" />
        <TextBlock Text="连接与模型" VerticalAlignment="Center" />
       </StackPanel>
      </RadioButton>
      <RadioButton x:Name="navImages" Style="{StaticResource Tab}" AutomationProperties.Name="图片服务">
       <StackPanel Orientation="Horizontal">
        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="25" VerticalAlignment="Center" />
        <TextBlock Text="图片服务" VerticalAlignment="Center" />
       </StackPanel>
      </RadioButton>
      <RadioButton x:Name="navAdvanced" Style="{StaticResource Tab}" AutomationProperties.Name="API 参数">
       <StackPanel Orientation="Horizontal">
        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="25" VerticalAlignment="Center" />
        <TextBlock Text="API 参数" VerticalAlignment="Center" />
       </StackPanel>
      </RadioButton>
      <RadioButton x:Name="navPlan" Style="{StaticResource Tab}" AutomationProperties.Name="启动摘要">
       <StackPanel Orientation="Horizontal">
        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="25" VerticalAlignment="Center" />
        <TextBlock Text="启动摘要" VerticalAlignment="Center" />
       </StackPanel>
      </RadioButton>
     </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="3,0,0,0">
     <Button x:Name="environmentButton" Content="环境设置" Style="{StaticResource Quiet}" FontSize="13" MinHeight="34" Padding="7,5" />
     <Button x:Name="helpButton" Content="使用说明" Style="{StaticResource Quiet}" FontSize="13" MinHeight="34" Padding="7,5" />
     <Button x:Name="recoveryButton" Content="恢复官方" Style="{StaticResource Quiet}" FontSize="13" MinHeight="34" Padding="7,5" />
    </StackPanel>
    <TextBlock x:Name="modeBadge" Visibility="Collapsed" />
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="32,28,32,20">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto" />
    <RowDefinition Height="*" />
    <RowDefinition Height="Auto" />
   </Grid.RowDefinitions>
   <Grid Margin="0,3,0,22">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock x:Name="pageTitle" Text="切换连接" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
     <TextBlock x:Name="pageSubtitle" Style="{StaticResource Caption}" Margin="0,7,0,0" />
    </StackPanel>
   </Grid>
   <ScrollViewer x:Name="contentScroll" Style="{StaticResource CompactScroll}" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="0,0,3,18">
     <StackPanel x:Name="pageHome" Visibility="Collapsed">
      <Border Background="{StaticResource StatusSurface}" CornerRadius="8" Padding="18,15" Margin="0,0,0,22">
       <Grid>
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*" />
         <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
         <StackPanel Orientation="Horizontal">
          <TextBlock Text="当前连接" Foreground="{StaticResource MutedInk}" FontSize="13" Margin="0,0,14,0" VerticalAlignment="Center" />
          <TextBlock x:Name="appliedConnection" Text="官方账号" FontSize="14" FontWeight="SemiBold" />
         </StackPanel>
         <TextBlock x:Name="runtimeStatus" Text="正在读取运行状态…" FontSize="13" Margin="0,7,0,0" MaxWidth="530" HorizontalAlignment="Left" />
        </StackPanel>
        <Button x:Name="refreshStateButton" Grid.Column="1" Content="刷新状态" Style="{StaticResource Quiet}" VerticalAlignment="Center" FontSize="13" />
       </Grid>
      </Border>
      <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Divider}" BorderThickness="{DynamicResource ControlStroke}" CornerRadius="12" Margin="0,0,0,14">
       <Grid Margin="25,23,25,22">
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*" />
         <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
         <TextBlock Text="官方账号" FontSize="17" FontWeight="SemiBold" />
         <TextBlock Text="使用原来的账号、模型与设置" Foreground="{StaticResource MutedInk}" FontSize="13" Margin="0,7,14,0" />
        </StackPanel>
        <Button x:Name="homeOfficialButton" Grid.Column="1" Content="打开官方 Codex" MinWidth="200" FontSize="13" MinHeight="44" VerticalAlignment="Center" Background="{StaticResource Surface}" BorderBrush="{StaticResource InputBorder}" Foreground="{StaticResource SecondaryInk}" />
       </Grid>
      </Border>
      <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Divider}" BorderThickness="{DynamicResource ControlStroke}" CornerRadius="12">
       <Grid Margin="25,23,25,25">
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*" />
         <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.ColumnSpan="2">
         <Grid>
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*" />
           <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
           <TextBlock Text="第三方 API" FontSize="17" FontWeight="SemiBold" />
           <TextBlock Text="使用左侧选中的接口配置" Foreground="{StaticResource MutedInk}" FontSize="13" Margin="0,7,0,0" />
          </StackPanel>
         </Grid>
         <Border x:Name="homeApiSummary" Background="{StaticResource InsetSurface}" CornerRadius="8" Padding="18,16" Margin="0,20,0,0">
          <Grid>
           <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
           </Grid.ColumnDefinitions>
           <StackPanel>
            <TextBlock Text="接口配置" FontSize="13" Foreground="{StaticResource MutedInk}" />
            <TextBlock x:Name="homeProfileValue" Text="{Binding Text, ElementName=nameBox}" LineHeight="24" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Text, ElementName=urlBox}" FontSize="13" Foreground="{StaticResource MutedInk}" Margin="0,6,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
           </StackPanel>
           <StackPanel Grid.Column="2">
            <TextBlock Text="默认模型" FontSize="13" Foreground="{StaticResource MutedInk}" />
            <TextBlock x:Name="homeModelValue" Text="{Binding Text, ElementName=modelBox}" LineHeight="24" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="readinessBadge" Text="检查基础信息…" FontSize="13" Margin="0,6,0,0" />
           </StackPanel>
          </Grid>
         </Border>
         <Grid Margin="0,20,0,0">
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*" />
           <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button x:Name="homeEditButton" Content="编辑配置" HorizontalAlignment="Left" Style="{StaticResource Quiet}" FontSize="13" />
          <Button x:Name="homeApiButton" Grid.Column="1" Content="使用 API 启动" Style="{StaticResource Primary}" MinHeight="46" MinWidth="200" FontSize="14" />
         </Grid>
        </StackPanel>
       </Grid>
      </Border>
      <Expander x:Name="homeDiagnostics" Visibility="Collapsed" Style="{StaticResource Disclosure}" IsExpanded="False" Margin="0,18,0,0" AutomationProperties.Name="展开连接检查">
       <Expander.Header>
        <StackPanel>
         <TextBlock Text="连接检查" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource SecondaryInk}" />
         <TextBlock Text="检查接口地址，或测试一次真实回复" FontSize="13" Foreground="{StaticResource MutedInk}" Margin="0,5,0,0" />
        </StackPanel>
       </Expander.Header>
       <StackPanel>
        <Border Background="{StaticResource InsetSurface}" CornerRadius="10" Padding="18,16" Margin="0,5,0,0">
         <Grid>
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*" />
           <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
           <TextBlock Text="{Binding Text, ElementName=checkTitle}" Foreground="{Binding Foreground, ElementName=checkTitle}" FontSize="13" />
           <TextBlock Text="{Binding Text, ElementName=checkDetail}" Foreground="{StaticResource MutedInk}" FontSize="13" Margin="0,5,16,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
           <Button x:Name="homeCheckButton" Style="{StaticResource Quiet}" Content="检查地址" FontSize="13" Padding="14,9" MinHeight="40" />
           <Button x:Name="homeProbeButton" Style="{StaticResource Primary}" Content="测试回复" FontSize="13" Padding="14,9" MinHeight="40" Margin="9,0,0,0" ToolTip="发送固定短提示，可能产生少量 API 用量；不发送聊天和项目。" />
          </StackPanel>
         </Grid>
        </Border>
        <TextBlock Text="测试回复会产生少量 API 用量。" FontSize="13" Foreground="{StaticResource MutedInk}" Margin="4,8,0,0" />
       </StackPanel>
      </Expander>
      <WrapPanel Margin="4,18,0,0">
       <TextBlock Text="聊天和项目继续共用；插件共享范围见说明。" Foreground="{StaticResource MutedInk}" FontSize="13" LineHeight="21" VerticalAlignment="Center" />
       <Button x:Name="homeSharingInfoButton" Style="{StaticResource InfoButton}" Margin="8,0,0,0" AutomationProperties.Name="插件共享范围说明" />
      </WrapPanel>
     </StackPanel>
     <StackPanel x:Name="pageConnection" MinHeight="0">
      <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Divider}" BorderThickness="{DynamicResource ControlStroke}" CornerRadius="12" Padding="18,10" Margin="0,0,0,10">
       <StackPanel>
        <TextBlock Text="接口凭据" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="地址和密钥按接口分别保存。" Style="{StaticResource SettingsHint}" Margin="0,5,0,18" Visibility="Collapsed" />
        <Grid>
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="116" />
          <ColumnDefinition Width="*" />
         </Grid.ColumnDefinitions>
         <TextBlock Text="配置名称" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" FontWeight="Normal" />
         <TextBox x:Name="nameBox" Grid.Column="1" MaxLength="64" AutomationProperties.Name="配置名称" />
        </Grid>
        <Grid Margin="0,8,0,0">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="116" />
          <ColumnDefinition Width="*" />
         </Grid.ColumnDefinitions>
         <StackPanel VerticalAlignment="Center">
          <TextBlock Text="接口地址" Style="{StaticResource SettingsLabel}" FontWeight="Normal" />
          <TextBlock Text="Base URL" Style="{StaticResource SettingsHint}" />
         </StackPanel>
         <TextBox x:Name="urlBox" FontFamily="{StaticResource DataFont}" Grid.Column="1" AutomationProperties.Name="接口地址" FontSize="14" />
        </Grid>
        <Grid Margin="0,8,0,0">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="116" />
          <ColumnDefinition Width="*" />
         </Grid.ColumnDefinitions>
         <TextBlock Text="API Key" Style="{StaticResource SettingsLabel}" Margin="0,12,0,0" FontWeight="Normal" />
         <StackPanel Grid.Column="1">
          <Grid>
           <TextBox x:Name="keyBox" AutomationProperties.Name="API Key" FontFamily="{StaticResource UiFont}" VerticalContentAlignment="Center" ToolTip="{Binding Text, ElementName=keyHint}" />
          </Grid>
          <TextBlock x:Name="keyHint" Style="{StaticResource SettingsHint}" Margin="0,8,0,0" Visibility="Collapsed" />
         </StackPanel>
        </Grid>
       </StackPanel>
      </Border>
      <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Divider}" BorderThickness="{DynamicResource ControlStroke}" CornerRadius="12" Padding="18,10" Margin="0,0,0,10">
       <StackPanel>
        <TextBlock Text="默认模型" Style="{StaticResource SectionTitle}" />
        <Grid Margin="0,8,0,0">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="116" />
          <ColumnDefinition Width="*" />
         </Grid.ColumnDefinitions>
         <TextBlock Text="默认模型" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" FontWeight="Normal" />
         <Grid Grid.Column="1">
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*" />
           <ColumnDefinition Width="10" />
           <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ComboBox x:Name="modelBox" FontFamily="{StaticResource DataFont}" IsEditable="True" IsTextSearchEnabled="False" AutomationProperties.Name="默认模型" />
          <Button x:Name="modelsButton" Grid.Column="2" Content="读取模型" FontSize="13" MinWidth="96" Padding="12,9" Background="{StaticResource InsetSurface}" Foreground="{StaticResource ActionInk}" BorderBrush="{StaticResource Divider}" />
         </Grid>
        </Grid>
        <TextBlock Text="选择对话模型后，可按需要启用下面的图片功能。" Style="{StaticResource SettingsHint}" Margin="116,10,0,0" Visibility="Collapsed" />
        <Grid Margin="0,8,0,0">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="116" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="96" />
         </Grid.ColumnDefinitions>
         <TextBlock Text="图片功能" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" FontWeight="Normal" />
         <ComboBox x:Name="imageBindingBox" Grid.Column="1" SelectedValuePath="Tag" AutomationProperties.Name="图片功能" />
         <StackPanel Grid.Column="3" Orientation="Horizontal">
          <Button x:Name="imageCurrentTestButton" Content="测试生图" Width="96" FontSize="13" Padding="12,9" Background="{StaticResource InsetSurface}" Foreground="{StaticResource ActionInk}" BorderBrush="{StaticResource Divider}" ToolTip="发送固定图片提示，可能产生服务商费用；不保存草稿。" />
          <Button x:Name="imageConfigureButton" Grid.Column="2" Content="配置图片" Width="96" FontSize="13" Padding="12,9" Background="{StaticResource InsetSurface}" Foreground="{StaticResource ActionInk}" BorderBrush="{StaticResource Divider}" />
         </StackPanel>
        </Grid>
        <TextBlock x:Name="imageBindingHint" Text="默认关闭。配置后在同一条聊天中调用，不切换对话模型。" Style="{StaticResource SettingsHint}" Margin="116,6,0,0" />
       </StackPanel>
      </Border>
      <StackPanel x:Name="connectionDiagnostics" Margin="0,8,0,0">
       <TextBlock Text="连接检查 · 测试回复会产生少量 API 用量" FontSize="13" Foreground="{StaticResource MutedInk}" />
       <Border Background="{StaticResource InsetSurface}" CornerRadius="8" Padding="15,12" Margin="0,5,0,0">
        <DockPanel>
         <Button x:Name="replyTestButton" Style="{StaticResource Primary}" DockPanel.Dock="Right" Content="测试回复" FontSize="13" Padding="13,8" MinHeight="36" Margin="9,0,0,0" ToolTip="发送固定短提示，可能产生少量 API 用量；不发送聊天和项目。" />
         <Button x:Name="testButton" Style="{StaticResource Quiet}" DockPanel.Dock="Right" Content="检查地址" FontSize="13" Padding="14,8" MinHeight="35" Margin="15,0,0,0" />
         <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="checkTitle" Text="尚未检查接口" FontSize="13" FontWeight="SemiBold" Foreground="#626B87" />
          <TextBlock x:Name="checkDetail" Text="检查模型列表，不发送聊天内容。" FontSize="13" Foreground="{StaticResource MutedInk}" Margin="0,4,0,0" />
         </StackPanel>
        </DockPanel>
       </Border>
      </StackPanel>
     </StackPanel>
     <StackPanel x:Name="pageImages" Visibility="Collapsed">
      <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Divider}" BorderThickness="{DynamicResource ControlStroke}" CornerRadius="12" Padding="24,21">
       <StackPanel>
        <TextBlock Text="选择图片服务" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="独立保存图片接口，在对话配置中选择使用。支持与对话不同的 URL 和 Key。" Style="{StaticResource SettingsHint}" />
        <Grid Margin="0,16,0,0">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
         </Grid.ColumnDefinitions>
         <ComboBox x:Name="imageServiceList" SelectedValuePath="Tag" AutomationProperties.Name="选择已保存的图片服务" />
         <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
          <Button x:Name="imageAddButton" Content="新增" Style="{StaticResource Quiet}" />
          <Button x:Name="imageCopyButton" Content="复制" Style="{StaticResource Quiet}" />
          <Button x:Name="imageDeleteButton" Content="移除" Style="{StaticResource Quiet}" />
         </StackPanel>
        </Grid>
        <TextBlock x:Name="imageEmptyHint" Text="还没有图片服务。点击“新增”，按服务商文档填写地址、模型和 Key。" Style="{StaticResource SettingsHint}" Margin="0,14,0,0" />
       </StackPanel>
      </Border>
      <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Divider}" BorderThickness="{DynamicResource ControlStroke}" CornerRadius="12" Padding="24,21" Margin="0,16,0,0" Visibility="{Binding Visibility, ElementName=imageEditor}">
       <StackPanel>
        <TextBlock Text="图片接口" Style="{StaticResource SectionTitle}" />
        <StackPanel x:Name="imageEditor">
         <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="116" />
           <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="服务名称" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" FontWeight="Normal" />
          <TextBox x:Name="imageNameBox" Grid.Column="1" AutomationProperties.Name="图片服务名称" />
         </Grid>
         <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="116" />
           <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Base URL" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" FontWeight="Normal" />
          <TextBox x:Name="imageUrlBox" FontFamily="{StaticResource DataFont}" Grid.Column="1" AutomationProperties.Name="图片接口地址" />
         </Grid>
         <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="116" />
           <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="图片模型" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" FontWeight="Normal" />
          <Grid Grid.Column="1">
           <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
           </Grid.ColumnDefinitions>
           <ComboBox x:Name="imageModelBox" FontFamily="{StaticResource DataFont}" IsEditable="True" IsTextSearchEnabled="False" AutomationProperties.Name="图片模型名" />
           <Button x:Name="imageModelsButton" Grid.Column="1" Content="读取模型" Margin="8,0,0,0" Padding="12,8" ToolTip="只读取模型列表，不生成图片。没有此接口时可手动填模型名。" />
          </Grid>
         </Grid>
         <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="116" />
           <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="API Key" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" FontWeight="Normal" />
          <TextBox x:Name="imageKeyBox" Grid.Column="1" AutomationProperties.Name="图片服务密钥" FontFamily="{StaticResource UiFont}" VerticalContentAlignment="Center" />
         </Grid>
         <TextBlock x:Name="imageKeyHint" Style="{StaticResource SettingsHint}" Margin="116,5,0,0" Text="保存后 Key 会自动显示，可直接修改。" />
         <Expander x:Name="imageAdvanced" Style="{StaticResource Disclosure}" Header="高级设置 · 返回方式、参数与保存位置" Margin="0,18,0,0">
          <StackPanel>
           <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
             <ColumnDefinition Width="116" />
             <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="返回方式" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" FontWeight="Normal" />
            <ComboBox x:Name="imageProtocolBox" Grid.Column="1" SelectedValuePath="Tag" AutomationProperties.Name="图片返回方式" />
           </Grid>
           <TextBlock x:Name="imageProtocolHint" Style="{StaticResource SettingsHint}" Margin="116,7,0,0" />
           <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
             <ColumnDefinition Width="116" />
             <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="尺寸" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" FontWeight="Normal" />
            <TextBox x:Name="imageSizeBox" Grid.Column="1" ToolTip="可选，例如 1024x1024；留空使用服务商默认。" />
           </Grid>
           <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
             <ColumnDefinition Width="116" />
             <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="质量" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" FontWeight="Normal" />
            <TextBox x:Name="imageQualityBox" Grid.Column="1" ToolTip="可选，例如 low、medium、high；必须由服务商支持。" />
           </Grid>
           <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
             <ColumnDefinition Width="116" />
             <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="输出格式" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" FontWeight="Normal" />
            <TextBox x:Name="imageFormatBox" Grid.Column="1" ToolTip="可选，例如 png、jpeg、webp；留空不发送此参数。" />
           </Grid>
           <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
             <ColumnDefinition Width="116" />
             <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="背景" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" FontWeight="Normal" />
            <TextBox x:Name="imageBackgroundBox" Grid.Column="1" ToolTip="可选，例如 transparent、opaque、auto；取决于模型能力。" />
           </Grid>
           <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
             <ColumnDefinition Width="116" />
             <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="等待时长（秒）" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" FontWeight="Normal" />
            <TextBox x:Name="imageWaitBox" Grid.Column="1" ToolTip="60–1800 秒，默认 600。已受理的异步任务可以继续查询。" />
           </Grid>
           <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
             <ColumnDefinition Width="116" />
             <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="网络方式" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" FontWeight="Normal" />
            <ComboBox x:Name="imageNetworkBox" Grid.Column="1" SelectedValuePath="Tag" />
           </Grid>
           <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
             <ColumnDefinition Width="116" />
             <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="保存目录" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" FontWeight="Normal" />
            <Grid Grid.Column="1">
             <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
             </Grid.ColumnDefinitions>
             <TextBox x:Name="imageOutputBox" FontFamily="{StaticResource DataFont}" AutomationProperties.Name="图片自定义保存目录" />
             <Button x:Name="imageFolderButton" Grid.Column="1" Content="选择" Style="{StaticResource Quiet}" Margin="8,0,0,0" />
            </Grid>
           </Grid>
           <TextBlock x:Name="imageOutputHint" Style="{StaticResource SettingsHint}" Margin="116,7,0,0" />
           <TextBlock Text="参数留空不发送；读取到模型名并不代表该模型支持所有尺寸、质量和改图参数。" Style="{StaticResource SettingsHint}" Margin="0,10,0,0" />
          </StackPanel>
         </Expander>
         <DockPanel Margin="0,20,0,0">
          <Button x:Name="imageSaveButton" Content="保存图片服务" Style="{StaticResource Primary}" DockPanel.Dock="Right" />
          <Button x:Name="imageDiscardButton" Content="撤销修改" Style="{StaticResource Quiet}" DockPanel.Dock="Right" Margin="0,0,8,0" />
          <TextBlock x:Name="imageEditBadge" Text="已保存" Foreground="{StaticResource MutedInk}" VerticalAlignment="Center" />
         </DockPanel>
        </StackPanel>
       </StackPanel>
      </Border>
      <Border Background="{StaticResource InsetSurface}" CornerRadius="12" Padding="24,21" Margin="0,16,0,0">
       <StackPanel>
        <TextBlock Text="图片检查" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="测试会生成一张简单图片，可能产生服务商费用。只发送固定测试描述，不发送聊天或项目。" Style="{StaticResource SettingsHint}" />
        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
         <Button x:Name="imageTestButton" Content="测试生图" />
         <Button x:Name="imageCancelButton" Content="停止等待" Style="{StaticResource Quiet}" Visibility="Collapsed" Margin="8,0,0,0" />
         <Button x:Name="imageOpenButton" Content="打开结果目录" Style="{StaticResource Quiet}" Margin="8,0,0,0" />
        </StackPanel>
        <TextBlock x:Name="imageCheckStatus" Text="尚未测试。保存后，在对话配置中选择此图片服务，并保存对话配置。" Style="{StaticResource SettingsHint}" Margin="0,12,0,0" />
        <Image x:Name="imageTestPreview" MaxWidth="360" MaxHeight="220" Stretch="Uniform" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,12,0,0" />
       </StackPanel>
      </Border>
     </StackPanel>
     <StackPanel x:Name="pageAdvanced" Visibility="Collapsed">
      <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Divider}" BorderThickness="{DynamicResource ControlStroke}" CornerRadius="12" Padding="24,21">
       <StackPanel>
        <TextBlock Text="思考与回答" Style="{StaticResource SectionTitle}" Margin="0,0,0,18" />
        <Grid>
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="210" />
         </Grid.ColumnDefinitions>
         <StackPanel>
          <StackPanel Orientation="Horizontal">
           <TextBlock Text="推理强度" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" FontWeight="Normal" />
           <Button x:Name="reasoningInfoButton" Style="{StaticResource InfoButton}" Margin="8,0,0,0" AutomationProperties.Name="推理强度说明" />
          </StackPanel>
          <TextBlock x:Name="reasoningHint" Text="保存后，在下次 API 启动时作为默认值。" Style="{StaticResource SettingsHint}" />
         </StackPanel>
         <ComboBox x:Name="reasoningBox" Grid.Column="2" SelectedValuePath="Tag" AutomationProperties.Name="推理强度" VerticalAlignment="Center" />
        </Grid>
        <Border Height="1" Background="{StaticResource Divider}" Margin="0,12,0,12" />
        <Grid>
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="210" />
         </Grid.ColumnDefinitions>
         <StackPanel VerticalAlignment="Center">
          <TextBlock Text="回答详细程度" Style="{StaticResource SettingsLabel}" FontWeight="Normal" />
          <TextBlock Text="控制回答默认展开的程度。" Style="{StaticResource SettingsHint}" />
         </StackPanel>
         <ComboBox x:Name="verbosityBox" Grid.Column="2" AutomationProperties.Name="回答详细程度" />
        </Grid>
        <Border Height="1" Background="{StaticResource Divider}" Margin="0,12,0,12" />
        <Grid>
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="210" />
         </Grid.ColumnDefinitions>
         <StackPanel VerticalAlignment="Center">
          <TextBlock Text="联网搜索" Style="{StaticResource SettingsLabel}" FontWeight="Normal" />
          <TextBlock Text="使用服务商提供的搜索能力。" Style="{StaticResource SettingsHint}" />
         </StackPanel>
         <ComboBox x:Name="searchBox" Grid.Column="2" AutomationProperties.Name="联网搜索" />
        </Grid>
       </StackPanel>
      </Border>
      <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Divider}" BorderThickness="{DynamicResource ControlStroke}" CornerRadius="12" Padding="24,21" Margin="0,16,0,0">
       <StackPanel>
        <TextBlock Text="上下文与工具" Style="{StaticResource SectionTitle}" Margin="0,0,0,18" />
        <Grid>
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="210" />
         </Grid.ColumnDefinitions>
         <StackPanel>
          <StackPanel Orientation="Horizontal">
           <TextBlock Text="上下文长度" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" FontWeight="Normal" />
           <Button x:Name="contextInfoButton" Style="{StaticResource InfoButton}" Margin="8,0,0,0" AutomationProperties.Name="上下文长度说明" />
          </StackPanel>
          <TextBlock x:Name="windowHint" Style="{StaticResource SettingsHint}" MaxWidth="345" HorizontalAlignment="Left" />
         </StackPanel>
         <ComboBox x:Name="windowBox" Grid.Column="2" IsEditable="True" IsTextSearchEnabled="False" AutomationProperties.Name="上下文长度" VerticalAlignment="Center" />
        </Grid>
        <Border Height="1" Background="{StaticResource Divider}" Margin="0,12,0,12" />
        <Grid>
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="210" />
         </Grid.ColumnDefinitions>
         <StackPanel>
          <StackPanel Orientation="Horizontal">
           <TextBlock Text="自动压缩阈值" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" FontWeight="Normal" />
           <Button x:Name="compactInfoButton" Style="{StaticResource InfoButton}" Margin="8,0,0,0" AutomationProperties.Name="自动压缩说明" />
          </StackPanel>
          <TextBlock Text="应小于有效的上下文长度。" Style="{StaticResource SettingsHint}" />
         </StackPanel>
         <ComboBox x:Name="compactBox" Grid.Column="2" IsEditable="True" IsTextSearchEnabled="False" AutomationProperties.Name="自动压缩阈值" VerticalAlignment="Center" />
        </Grid>
        <Border Height="1" Background="{StaticResource Divider}" Margin="0,12,0,12" />
        <Grid>
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="210" />
         </Grid.ColumnDefinitions>
         <StackPanel>
          <TextBlock Text="工具输出预算" Style="{StaticResource SettingsLabel}" FontWeight="Normal" />
          <TextBlock Text="单次工具结果保留的 token 数。" Style="{StaticResource SettingsHint}" />
         </StackPanel>
         <ComboBox x:Name="toolBox" Grid.Column="2" IsEditable="True" IsTextSearchEnabled="False" AutomationProperties.Name="工具输出预算" VerticalAlignment="Center" />
        </Grid>
       </StackPanel>
      </Border>
     </StackPanel>
     <StackPanel x:Name="pagePlan" Visibility="Collapsed">
      <Border Background="{StaticResource InsetSurface}" CornerRadius="10" Padding="16,14" Margin="0,0,0,16">
       <StackPanel>
        <TextBlock Text="先完全退出 Codex，再切换连接" FontSize="13" Foreground="{StaticResource ActionInk}" />
        <TextBlock Text="请一并退出系统托盘中的 Codex；保存配置不会立即切换。" FontSize="13" Foreground="{StaticResource MutedInk}" Margin="0,5,0,0" />
       </StackPanel>
      </Border>
      <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Divider}" BorderThickness="{DynamicResource ControlStroke}" CornerRadius="12" Padding="24,21">
       <StackPanel>
        <TextBlock Text="本次启动使用" Style="{StaticResource SectionTitle}" />
        <Grid Margin="0,18,0,0">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="116" />
          <ColumnDefinition Width="*" />
         </Grid.ColumnDefinitions>
         <Grid.RowDefinitions>
          <RowDefinition Height="40" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="40" />
          <RowDefinition Height="40" />
          <RowDefinition Height="40" />
          <RowDefinition Height="40" />
          <RowDefinition Height="Auto" />
         </Grid.RowDefinitions>
         <TextBlock Text="API 接口" Style="{StaticResource SummaryLabel}" />
         <TextBlock Grid.Column="1" Text="{Binding Text, ElementName=nameBox}" Style="{StaticResource SummaryValue}" />
         <TextBlock Grid.Row="1" Text="接口地址" Style="{StaticResource SummaryLabel}" />
         <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Text, ElementName=urlBox}" Style="{StaticResource SummaryValue}" FontSize="13" Margin="0,8,0,8" />
         <TextBlock Grid.Row="2" Text="默认模型" Style="{StaticResource SummaryLabel}" />
         <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Text, ElementName=modelBox}" Style="{StaticResource SummaryValue}" />
         <TextBlock Grid.Row="3" Text="上下文长度" Style="{StaticResource SummaryLabel}" />
         <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Text, ElementName=windowBox}" Style="{StaticResource SummaryValue}" />
         <TextBlock Grid.Row="4" Text="自动压缩阈值" Style="{StaticResource SummaryLabel}" />
         <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Text, ElementName=compactBox}" Style="{StaticResource SummaryValue}" />
         <TextBlock Grid.Row="5" Text="API Key" Style="{StaticResource SummaryLabel}" />
         <TextBlock x:Name="planKeyStatus" Grid.Row="5" Grid.Column="1" Text="待输入" Style="{StaticResource SummaryValue}" />
         <TextBlock Grid.Row="6" Text="其他参数" Style="{StaticResource SummaryLabel}" />
         <TextBlock x:Name="planPreferences" Grid.Row="6" Grid.Column="1" Text="" Style="{StaticResource SummaryValue}" FontSize="13" Margin="0,8,0,8" />
        </Grid>
        <Border Height="1" Background="{StaticResource Divider}" Margin="0,15,0,17" />
        <TextBlock Text="继续使用原来的工作环境" Style="{StaticResource SettingsLabel}" FontWeight="Normal" />
        <TextBlock Text="聊天和项目共用本地目录。插件安装、启用与连接状态可在下方核对。切回官方恢复原登录与设置。" Style="{StaticResource SettingsHint}" />
        <TextBox x:Name="planText" Visibility="Collapsed" IsReadOnly="True" />
       </StackPanel>
      </Border>
      <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Divider}" BorderThickness="{DynamicResource ControlStroke}" CornerRadius="12" Padding="24,21" Margin="0,18,0,0">
       <StackPanel>
        <StackPanel Orientation="Horizontal">
         <TextBlock Text="插件与技能共享检查" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
         <Button x:Name="sharingInfoButton" Style="{StaticResource InfoButton}" Margin="10,0,0,0" AutomationProperties.Name="插件共享范围说明" />
        </StackPanel>
        <TextBlock Text="分别在官方、API 模式检查一次。结果区分发现、安装、启用和调用；不自动重装插件。" Style="{StaticResource SettingsHint}" Margin="0,8,0,0" />
        <TextBlock Text="项目目录（可选，用于发现项目技能）" Style="{StaticResource SettingsLabel}" Margin="0,14,0,6" FontWeight="Normal" />
        <TextBox x:Name="compatibilityCwd" FontFamily="{StaticResource DataFont}" AutomationProperties.Name="兼容检查项目目录" />
        <StackPanel Orientation="Horizontal" Margin="0,12,0,12">
         <Button x:Name="compatibilityCheck" Content="检查当前模式" />
         <Button x:Name="compatibilityCancel" Content="停止检查" Visibility="Collapsed" Style="{StaticResource Quiet}" Margin="8,0,0,0" />
        </StackPanel>
        <TextBlock x:Name="compatibilitySummary" Text="尚未检查。检查不代表插件实际调用成功。" Style="{StaticResource SettingsHint}" />
        <Expander x:Name="compatibilityDetails" Header="查看安装、技能与连接明细" Style="{StaticResource Disclosure}" Margin="0,12,0,0">
         <ScrollViewer x:Name="compatibilityDetailScroll" Style="{StaticResource CompactScroll}" MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0" AutomationProperties.Name="插件与技能检查明细">
          <TextBlock x:Name="compatibilityDetail" Text="尚未检查。不会读取对话正文。" Style="{StaticResource SettingsHint}" Margin="0,0,8,0" />
         </ScrollViewer>
        </Expander>
        <StackPanel x:Name="compatibilityRepairPanel" Visibility="Collapsed" Margin="0,16,0,0">
         <TextBlock Text="可安装或修复的本地插件" Style="{StaticResource SettingsLabel}" FontWeight="Normal" />
         <ComboBox x:Name="compatibilityRepairChoice" Margin="0,8,0,0" AutomationProperties.Name="选择本地插件登记修复" />
         <TextBlock x:Name="compatibilityRepairPreview" Style="{StaticResource SettingsHint}" Margin="0,8,0,8" />
         <Button x:Name="compatibilityRepair" Content="安装或修复所选本地插件" HorizontalAlignment="Left" />
        </StackPanel>
       </StackPanel>
      </Border>
      <DockPanel Margin="3,15,0,0">
       <Button x:Name="defaultsButton" DockPanel.Dock="Right" Content="恢复继承值" FontSize="13" MinHeight="34" Padding="12,7" Margin="16,0,0,0" />
       <TextBlock Text="已有聊天可能保留自己的模型选择，进入聊天后请查看右下角。" Style="{StaticResource SettingsHint}" VerticalAlignment="Center" />
      </DockPanel>
     </StackPanel>
    </Grid>
   </ScrollViewer>
   <StackPanel Grid.Row="2">
    <TextBlock x:Name="inlineError" Visibility="Collapsed" Foreground="{StaticResource DangerInk}" FontSize="13" Margin="0,0,0,10" />
    <Border x:Name="footerDivider" Height="1" Background="{StaticResource Divider}" Margin="0,0,0,16" />
    <DockPanel x:Name="footerActions">
     <Button x:Name="apiButton" DockPanel.Dock="Right" Content="保存并启动 API" Style="{StaticResource Primary}" MinWidth="164" Margin="10,0,0,0" FontSize="13" />
     <Button x:Name="saveButton" DockPanel.Dock="Right" Content="保存配置" MinWidth="94" FontSize="13" />
     <Button x:Name="discardButton" DockPanel.Dock="Right" Content="撤销修改" Style="{StaticResource Quiet}" FontSize="13" Margin="0,0,8,0" Visibility="Collapsed" ToolTip="撤销当前接口未保存的修改" />
     <StackPanel VerticalAlignment="Center">
      <TextBlock x:Name="editBadge" Text="已保存" FontSize="13" Foreground="{StaticResource MutedInk}" />
     </StackPanel>
    </DockPanel>
    <DockPanel Margin="0,11,0,0">
     <Button x:Name="cancelCheckButton" DockPanel.Dock="Right" Content="取消检查" Style="{StaticResource Quiet}" FontSize="13" Padding="9,4" MinHeight="26" Visibility="Collapsed" />
     <TextBlock x:Name="status" Text="准备就绪。切换前请完全退出 Codex。" Style="{StaticResource Caption}" FontSize="13" MinHeight="19" VerticalAlignment="Center" />
    </DockPanel>
   </StackPanel>
  </Grid>
  <Popup x:Name="settingsHelpPopup" Placement="Bottom" AllowsTransparency="True" StaysOpen="False" PopupAnimation="None" VerticalOffset="7">
   <Border Background="{StaticResource InsetSurface}" BorderBrush="{StaticResource Divider}" BorderThickness="{DynamicResource ControlStroke}" CornerRadius="12" Padding="17,15" Width="338">
    <StackPanel>
     <DockPanel>
      <Button x:Name="helpCloseButton" DockPanel.Dock="Right" Content="×" Style="{StaticResource Quiet}" Width="24" MinHeight="24" Height="24" Padding="0" AutomationProperties.Name="关闭设置说明" />
      <TextBlock x:Name="settingsHelpTitle" FontSize="13" Foreground="{StaticResource ActionInk}" FontWeight="SemiBold" VerticalAlignment="Center" />
     </DockPanel>
     <ScrollViewer x:Name="settingsHelpScroll" Style="{StaticResource CompactScroll}" MaxHeight="400" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
      <TextBlock x:Name="settingsHelpDetail" FontSize="13" Foreground="{StaticResource MutedInk}" LineHeight="22" Margin="0,0,6,0" />
     </ScrollViewer>
    </StackPanel>
   </Border>
  </Popup>
  <Border x:Name="resultToast" Grid.Column="1" Panel.ZIndex="100" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" MaxWidth="540" Margin="24,16,24,0" Padding="18,14" CornerRadius="12" BorderThickness="{DynamicResource ControlStroke}" Background="#EFF5FA" BorderBrush="#DCE5ED" AutomationProperties.Name="操作结果">
   <Border.Effect>
    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.12" Color="#263047" />
   </Border.Effect>
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="36" />
     <ColumnDefinition Width="*" />
     <ColumnDefinition Width="32" />
    </Grid.ColumnDefinitions>
    <Border Width="27" Height="27" CornerRadius="8" VerticalAlignment="Top">
     <Border.Background><SolidColorBrush Color="{Binding Foreground.Color, ElementName=resultToastIcon}" Opacity="0.08" /></Border.Background>
     <TextBlock x:Name="resultToastIcon" Text="i" FontFamily="Segoe UI" FontSize="17" Foreground="{StaticResource ActionInk}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    <StackPanel Grid.Column="1">
     <TextBlock x:Name="resultToastTitle" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource ActionInk}" />
     <TextBlock x:Name="resultToastDetail" FontSize="13" LineHeight="21" MaxHeight="168" TextTrimming="CharacterEllipsis" Foreground="{StaticResource SecondaryInk}" Margin="0,5,12,0" />
     <Button x:Name="resultToastMore" Content="查看详情" Style="{StaticResource Quiet}" HorizontalAlignment="Left" MinHeight="28" Padding="8,4" Margin="-8,5,0,0" Visibility="Collapsed" AutomationProperties.Name="查看完整操作结果" />
    </StackPanel>
    <Button x:Name="resultToastClose" Grid.Column="2" Content="×" Style="{StaticResource Quiet}" Width="32" Height="32" MinHeight="32" Padding="0" VerticalAlignment="Top" FontSize="18" AutomationProperties.Name="关闭操作结果提示" ToolTip="关闭提示（Esc）" />
   </Grid>
  </Border>
 </Grid>
</Window>
